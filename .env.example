# Postgres lokal (buat database + user, lalu migrasi: npm run db:migrate / db:fresh)
# Contoh: postgresql://USER:PASSWORD@localhost:5432/wayo
DATABASE_URL="postgresql://wayo:wayo@localhost:5432/wayo"
# Koneksi langsung (tanpa pooler) untuk prisma migrate. Lokal: samakan dengan DATABASE_URL.
# Neon/Supabase: isi URL "direct" / "non-pooling", DATABASE_URL boleh URL pooled.
DIRECT_URL="postgresql://wayo:wayo@localhost:5432/wayo"
BASE_URL="http://localhost:3000"
WAYO_DEMO="1"

# --- Akun Admin (dibuat oleh seed; ganti di produksi) ---
# WAYO_ADMIN_EMAIL="admin@wayo.local"
# WAYO_ADMIN_PASSWORD="admin123"

# --- Login/Daftar dengan Google (OAuth 2.0). Kosong = tombol Google menampilkan pesan "belum dikonfigurasi" ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Default: ${BASE_URL}/api/auth/google/callback — daftarkan URL ini di Google Cloud Console (Authorized redirect URIs)
GOOGLE_REDIRECT_URI=""

# --- Email atur ulang password (SMTP via nodemailer). SMTP_HOST kosong = tautan reset dicetak di console server (dev) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# SMTP_SECURE="false"   # default: true bila port 465
MAIL_FROM="WAYO <no-reply@wayo.local>"

# --- Rute jalan (opsional) ---
# OSRM_URL="https://router.project-osrm.org"

# --- Penyimpanan file di Vercel (wajib di produksi). Kosong = disk lokal data/uploads & data/proposals ---
# Buat Blob store di dashboard Vercel (Storage → Blob), lalu salin token.
# BLOB_READ_WRITE_TOKEN=""
